<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>小兔进销存</string>
  <key>CFBundleDisplayName</key>
  <string>小兔进销存</string>
  <key>CFBundleIdentifier</key>
  <string>com.simem.xiaotu</string>
  <key>CFBundleDevelopmentRegion</key>
  <string>zh_CN</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>zh_CN</string>
  </array>
  <key>CFBundleExecutable</key>
  <string>xiaotu-inventory</string>
  <key>CFBundleIconFile</key>
  <string>xiaotu.icns</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@PROJECT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@XIAOTU_BUILD@</string>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © 2026 小兔在线. All rights reserved.</string>
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <!-- 更新：以下键由 tools/package/package_macos.sh 通过 CMake 变量注入，仓库内保持为空；
       为空表示更新功能关闭。定时检查由 XiaotuUpdater 负责（24h±2h）。
       这些 Sparkle 键只被 Sparkle 读取，本仓库代码不读取；未链接 Sparkle 时它们是
       占位、不生效。Q25 口径：允许自动检查与后台预下载，但安装必须由用户显式点击、
       确认会关闭程序后才执行；从不静默安装。SUAutomaticallyUpdate 的语义包含
       “自动安装”，因此固定为 false；后台预下载由自研下载链路负责，不依赖该键。
       SUAllowsAutomaticUpdates=false 进一步关闭 Sparkle 的自动更新；
       SUEnableAutomaticChecks=false 关闭 Sparkle 自己的定时检查，避免双份检查/提示。 -->
  <key>XiaotuUpdateManifestURL</key>
  <string>@XIAOTU_UPDATE_MANIFEST_URL_XML@</string>
  <key>XiaotuUpdateChannel</key>
  <string>stable</string>
  <key>SUFeedURL</key>
  <string>@XIAOTU_UPDATE_FEED_URL_XML@</string>
  <key>SUPublicEDKey</key>
  <string>@XIAOTU_UPDATE_PUBKEY_XML@</string>
  <key>SUEnableAutomaticChecks</key>
  <false/>
  <key>SUAutomaticallyUpdate</key>
  <false/>
  <key>SUAllowsAutomaticUpdates</key>
  <false/>
</dict>
</plist>
