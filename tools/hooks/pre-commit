#!/usr/bin/env bash
# pre-commit hook — PowerShell 5 编码门禁
#
# Windows PowerShell 5 只正确识别 UTF-8 + BOM（EF BB BF）的 .ps1。
# UTF-8 无 BOM 会被按 GBK 读，中文字面量断裂 → 脚本崩溃。
#
# 这个 hook 扫描所有 staged 的 .ps1 文件，前 3 字节不是 EF BB BF 就阻断提交。
# 用法：git config core.hooksPath tools/hooks（见 setup-hooks.ps1）。

set -u

fail_count=0
checked=0

# 取所有 staged 的 .ps1（新建/修改/重命名都含 --diff-filter=ACM 也够）
mapfile -t ps1_files < <(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '\.ps1$' || true)

if [ "${#ps1_files[@]}" -eq 0 ]; then
    exit 0  # 没有 .ps1 变更，放行
fi

RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'

echo -e "${YELLOW}[hook] 检查 .ps1 UTF-8 + BOM${NC}"

for f in "${ps1_files[@]}"; do
    # 取 staged 版本的前 3 字节（不是工作区的，防止本地有改动没 add）
    bom=$(git show ":$f" 2>/dev/null | head -c 3 | od -An -tx1 | tr -d ' \n')
    checked=$((checked + 1))

    if [ "$bom" = "efbbbf" ]; then
        echo -e "  ${GREEN}✓${NC} $f （UTF-8 + BOM）"
    else
        echo -e "  ${RED}✗${NC} $f 缺少 UTF-8 BOM（当前前 3 字节：$bom）"
        echo -e "     ${YELLOW}修复：${NC} python -c \"p=open('$f','rb'); b=p.read(); p=open('$f','wb'); p.write(b'\xef\xbb\xbf'+b); p.close()\""
        echo -e "     或：${YELLOW}powershell -Command \"\$b=[IO.File]::ReadAllBytes('$f'); [IO.File]::WriteAllBytes('$f', [byte[]](0xEF,0xBB,0xBF) + \$b)\""
        fail_count=$((fail_count + 1))
    fi
done

echo -e ""
if [ $fail_count -gt 0 ]; then
    echo -e "${RED}[hook] 阻断：${fail_count}/${checked} 个 .ps1 缺少 UTF-8 BOM${NC}"
    echo -e "       PowerShell 5 在 Windows 上会把无 BOM 的 UTF-8 当 GBK 读，"
    echo -e "       中文字面量断裂导致脚本崩溃（本次会话已出现多次）。"
    echo -e "       如果你确信要绕过，用 ${YELLOW}git commit --no-verify${NC}（不推荐）。"
    exit 1
else
    echo -e "${GREEN}[hook] 通过：${checked} 个 .ps1 都是 UTF-8 + BOM${NC}"
    exit 0
fi
