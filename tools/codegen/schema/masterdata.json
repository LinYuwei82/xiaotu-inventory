{
  "name": "masterdata",
  "targets": {
    "core_include": "core/include/xiaotu/gen",
    "core_src": "core/src/gen",
    "server_include": "server/include/xiaotu/gen",
    "server_src": "server/src/gen",
    "web": "web/gen"
  },
  "tables": [
    {
      "table": "item",
      "key": "item",
      "entity": "商品",
      "api": "/api/items",
      "permissions": { "read": "item.read", "write": "item.write" },
      "nav_group": "master",
      "import": true,
      "order_by": "code",
      "custom_list": true,
      "page_render": "itemPage",
      "fields": [
        { "name": "code", "label": "编码", "type": "string", "required": true, "unique": true, "in_list": true, "in_form": true },
        { "name": "name", "label": "名称", "type": "string", "required": true, "unique": false, "in_list": true, "in_form": true },
        { "name": "spec", "label": "规格", "type": "string", "required": false, "unique": false, "in_list": true, "in_form": true },
        { "name": "barcode", "label": "条码", "type": "string", "required": false, "unique": false, "unique_nonempty": true, "in_list": true, "in_form": true },
        { "name": "unit", "label": "单位", "type": "string", "required": false, "unique": false, "in_list": true, "in_form": false, "default": "件" },
        { "name": "unit_id", "label": "计量单位", "type": "int", "required": false, "unique": false, "in_list": false, "in_form": true, "default": 1,
          "options_api": "/api/units", "reference": { "table": "unit", "display": "name" }, "sync_to": "unit" },
        { "name": "category_id", "label": "商品分类", "type": "int", "required": false, "unique": false, "in_list": true, "in_form": true, "default": 0,
          "options_api": "/api/item-categories" },
        { "name": "tax_rate_bp", "label": "税率（万分比）", "type": "int", "required": false, "unique": false, "in_list": false, "in_form": true, "default": 0, "min": 0, "max": 10000 },
        { "name": "status", "label": "启用", "type": "bool", "required": false, "unique": false, "in_list": true, "in_form": true, "default": true }
      ]
    },
    {
      "table": "unit",
      "key": "unit",
      "entity": "计量单位",
      "api": "/api/units",
      "permissions": { "read": "unit.read", "write": "unit.write" },
      "nav_group": "master",
      "order_by": "code",
      "fields": [
        { "name": "code", "label": "编码", "type": "string", "required": true, "unique": true, "in_list": true, "in_form": true },
        { "name": "name", "label": "名称", "type": "string", "required": true, "unique": false, "in_list": true, "in_form": true },
        { "name": "qty_decimals", "label": "数量小数位", "type": "int", "required": false, "unique": false, "in_list": true, "in_form": true, "default": 0, "min": 0, "max": 4 },
        { "name": "status", "label": "启用", "type": "bool", "required": false, "unique": false, "in_list": true, "in_form": true, "default": true }
      ]
    },
    {
      "table": "warehouse",
      "key": "warehouse",
      "entity": "仓库",
      "api": "/api/warehouses",
      "permissions": { "read": "warehouse.read", "write": "warehouse.write" },
      "nav_group": "master",
      "order_by": "code",
      "fields": [
        { "name": "code", "label": "编码", "type": "string", "required": true, "unique": true, "in_list": true, "in_form": true },
        { "name": "name", "label": "名称", "type": "string", "required": true, "unique": false, "in_list": true, "in_form": true },
        { "name": "is_default", "label": "默认仓", "type": "bool", "required": false, "unique": false, "in_list": true, "in_form": true, "default": false },
        { "name": "status", "label": "启用", "type": "bool", "required": false, "unique": false, "in_list": true, "in_form": true, "default": true }
      ]
    },
    {
      "table": "customer",
      "key": "customer",
      "entity": "客户",
      "api": "/api/customers",
      "permissions": { "read": "customer.read", "write": "customer.write" },
      "nav_group": "master",
      "import": true,
      "order_by": "code",
      "fields": [
        { "name": "code", "label": "编码", "type": "string", "required": true, "unique": true, "in_list": true, "in_form": true },
        { "name": "name", "label": "名称", "type": "string", "required": true, "unique": false, "in_list": true, "in_form": true },
        { "name": "contact", "label": "联系人", "type": "string", "required": false, "unique": false, "in_list": true, "in_form": true },
        { "name": "phone", "label": "电话", "type": "string", "required": false, "unique": false, "in_list": true, "in_form": true },
        { "name": "address", "label": "地址", "type": "string", "required": false, "unique": false, "in_list": false, "in_form": true },
        { "name": "status", "label": "启用", "type": "bool", "required": false, "unique": false, "in_list": true, "in_form": true, "default": true }
      ]
    },
    {
      "table": "supplier",
      "key": "supplier",
      "entity": "供应商",
      "api": "/api/suppliers",
      "permissions": { "read": "supplier.read", "write": "supplier.write" },
      "nav_group": "master",
      "import": true,
      "order_by": "code",
      "fields": [
        { "name": "code", "label": "编码", "type": "string", "required": true, "unique": true, "in_list": true, "in_form": true },
        { "name": "name", "label": "名称", "type": "string", "required": true, "unique": false, "in_list": true, "in_form": true },
        { "name": "contact", "label": "联系人", "type": "string", "required": false, "unique": false, "in_list": true, "in_form": true },
        { "name": "phone", "label": "电话", "type": "string", "required": false, "unique": false, "in_list": true, "in_form": true },
        { "name": "address", "label": "地址", "type": "string", "required": false, "unique": false, "in_list": false, "in_form": true },
        { "name": "status", "label": "启用", "type": "bool", "required": false, "unique": false, "in_list": true, "in_form": true, "default": true }
      ]
    },
    {
      "table": "employee",
      "key": "employee",
      "entity": "职员",
      "api": "/api/employees",
      "permissions": { "read": "employee.read", "write": "employee.write" },
      "nav_group": "master",
      "order_by": "code",
      "quota": "max_employees",
      "fields": [
        { "name": "code", "label": "工号", "type": "string", "required": true, "unique": true, "in_list": true, "in_form": true },
        { "name": "name", "label": "姓名", "type": "string", "required": true, "unique": false, "in_list": true, "in_form": true },
        { "name": "phone", "label": "电话", "type": "string", "required": false, "unique": false, "in_list": true, "in_form": true },
        { "name": "department", "label": "部门", "type": "string", "required": false, "unique": false, "in_list": true, "in_form": true },
        { "name": "position", "label": "职位", "type": "string", "required": false, "unique": false, "in_list": false, "in_form": true },
        { "name": "user_id", "label": "绑定登录账号", "type": "int", "required": false, "unique": false, "in_list": false, "in_form": false, "default": 0 },
        { "name": "status", "label": "在职", "type": "bool", "required": false, "unique": false, "in_list": true, "in_form": true, "default": true }
      ]
    },
    {
      "table": "fund_account",
      "key": "fund_account",
      "entity": "资金账户",
      "api": "/api/fund-accounts",
      "permissions": { "read": "finance.read", "write": "finance.write" },
      "nav_group": "finance",
      "order_by": "sort_order, id",
      "fields": [
        { "name": "code", "label": "编码", "type": "string", "required": true, "unique": true, "in_list": true, "in_form": true },
        { "name": "name", "label": "名称", "type": "string", "required": true, "unique": true, "in_list": true, "in_form": true },
        { "name": "kind", "label": "类型（CASH/BANK/WECHAT/ALIPAY/OTHER）", "type": "string", "required": true, "unique": false, "in_list": true, "in_form": true, "default": "CASH" },
        { "name": "account_no", "label": "账号", "type": "string", "required": false, "unique": false, "in_list": true, "in_form": true },
        { "name": "bank_name", "label": "开户行", "type": "string", "required": false, "unique": false, "in_list": false, "in_form": true },
        { "name": "opening_cents", "label": "期初余额（分）", "type": "int", "required": false, "unique": false, "in_list": true, "in_form": true, "default": 0 },
        { "name": "sort_order", "label": "排序", "type": "int", "required": false, "unique": false, "in_list": true, "in_form": true, "default": 0 },
        { "name": "status", "label": "启用", "type": "bool", "required": false, "unique": false, "in_list": true, "in_form": true, "default": true }
      ]
    }
  ]
}
