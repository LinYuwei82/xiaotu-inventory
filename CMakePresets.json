{
  "version": 6,
  "configurePresets": [
    {
      "name": "macos-dev",
      "displayName": "macOS 开发态（Ninja + ccache，前端走 dev server）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "XIAOTU_DEV_WEB": "ON"
      },
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;files,${sourceDir}/.vcpkg-cache,readwrite"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS 发布态（Ninja + ccache，前端内嵌进二进制）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "XIAOTU_DEV_WEB": "OFF"
      },
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;files,${sourceDir}/.vcpkg-cache,readwrite"
      }
    },
    {
      "name": "macos-community",
      "displayName": "macOS 社区版（Ninja + ccache，无 WebView 壳，用于能力/额度验证）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/community",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "XIAOTU_EDITION": "community",
        "XIAOTU_BUILD_SHELL": "OFF",
        "XIAOTU_DEV_WEB": "OFF"
      },
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;files,${sourceDir}/.vcpkg-cache,readwrite"
      }
    },
    {
      "name": "linux-ci",
      "displayName": "Linux CI（Ninja，无 WebView 壳）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "XIAOTU_BUILD_SHELL": "OFF"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows 服务端（Ninja，无 WebView 壳，浏览器访问）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "XIAOTU_BUILD_SHELL": "OFF",
        "XIAOTU_DEV_WEB": "OFF"
      }
    },
    {
      "name": "windows-dev",
      "displayName": "Windows 开发态（Ninja，无 WebView 壳，前端走 dev server）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "XIAOTU_BUILD_SHELL": "OFF",
        "XIAOTU_DEV_WEB": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "macos-dev" },
    { "name": "release", "configurePreset": "macos-release" },
    { "name": "community", "configurePreset": "macos-community" },
    { "name": "linux-ci", "configurePreset": "linux-ci" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "windows-dev", "configurePreset": "windows-dev" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "macos-dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "macos-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "community",
      "configurePreset": "macos-community",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
