# 小兔进销存 每日备份（cron.d 格式）
# 安装：cp deploy/cron/xiaotu-backup /etc/cron.d/xiaotu-backup && chmod 644 /etc/cron.d/xiaotu-backup
# 统一调用 deploy/backup.sh；与 systemd timer 二选一，不要同时启用。
SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

30 2 * * * xiaotu /opt/xiaotu/deploy/backup.sh >> /var/log/xiaotu/backup.log 2>&1
