# 小兔进销存配置文件示例。
# 复制到 /etc/xiaotu/config.toml 后按实际环境修改。
# 优先级：命令行 > 环境变量 > 本文件 > 内置默认。

[server]
# 监听地址：0.0.0.0 表示所有网卡；只给本机用可改成 127.0.0.1
listen = "0.0.0.0"
# 监听端口，1–65535
port = 8080

[storage]
# 数据目录：app.db、backups/ 都在这里
data_dir = "/var/lib/xiaotu"

[log]
# debug / info / warn / error
level = "info"
# 日志目录：app.log 按 5MB 滚动，保留 app.log.1–app.log.3
dir = "/var/log/xiaotu"

[sales]
# 客户信用额度超额行为：warn 提示并二次确认后放行（写审计）；reject 直接拒绝
credit_limit_mode = "warn"
