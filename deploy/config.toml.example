# 小兔进销存配置文件示例。
# 复制到 /etc/xiaotu/config.toml 后按实际环境修改。
# 优先级：命令行 > 环境变量 > 本文件 > 内置默认。

[server]
# 监听地址：0.0.0.0 表示所有网卡；只给本机用可改成 127.0.0.1
listen = "0.0.0.0"
# 监听端口，1–65535
port = 8080

[storage]
# 数据目录：app.db、日志与默认备份目录都在这里
data_dir = "/var/lib/xiaotu"
# 备份目录（可选）：留空表示 <data_dir>/backups；
# 相对路径按 data_dir 解析，绝对路径原样使用；不可写时备份直接报错，不会回落。
backup_dir = ""

[log]
# debug / info / warn / error
level = "info"
# 日志目录：app.log 按 5MB 滚动，保留 app.log.1–app.log.3
dir = "/var/log/xiaotu"

[sales]
# 客户信用额度超额行为：warn 提示并二次确认后放行（写审计）；reject 直接拒绝
credit_limit_mode = "warn"

[update]
# 网络版更新源：manifest_file 为空表示不启用自动检查。
# auto_check = true   # 启动 30 秒后与每 24h±2h 自动检查
# prefetch = true     # 自动检查命中新版本时后台下载并校验安装包
# manifest_file = "/srv/xiaotu-updates/macos/stable/latest.json"
# channel = "stable"
# rollout_percent = 100
