# 更新源 Nginx 示例（放到 /etc/nginx/conf.d/xiaotu-updates.conf 后 reload）
#
# 目录约定（见 docs/更新模块技术方案.md 第 8 节）：
#   /srv/xiaotu-updates/macos/stable/latest.json
#   /srv/xiaotu-updates/macos/stable/appcast.xml
#   /srv/xiaotu-releases/macos/1.4.2/xiaotu-1.4.2.dmg
#
# 发布流程：先上传安装包到 releases，再原子替换 latest.json/appcast.xml，
# 最后 purge CDN。回滚时把 latest.json 指回旧版本并保留回滚包。

server {
    listen 443 ssl;
    http2 on;
    server_name updates.example.com;

    ssl_certificate     /etc/letsencrypt/live/updates.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/updates.example.com/privkey.pem;

    root /srv/xiaotu-updates;

    # 清单与 appcast 允许 5 分钟缓存，发布后主动 purge。
    location ~ ^/(macos|windows)/(stable|beta)/(latest\.json|appcast\.xml)$ {
        default_type application/json;
        add_header Cache-Control "no-cache, max-age=300";
        add_header X-Content-Type-Options "nosniff";
        try_files $uri =404;
    }

    # 安装包按版本归档，不可变，长缓存。
    location /releases/ {
        alias /srv/xiaotu-releases/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff";
        try_files $uri =404;
    }

    # 禁止目录列表与隐藏文件。
    location ~ /\. {
        deny all;
    }
    autoindex off;
}
